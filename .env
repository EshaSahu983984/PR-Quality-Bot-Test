# Application settings
APP_NAME=MyAwesomeApp
APP_ENV=development
APP_PORT=8080

# Database configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mydatabase
DB_USER=myuser
DB_PASSWORD=supersecretpassword

# API keys and credentials
API_KEY=12345abcdef
API_SECRET=shhh_its_a_secret

# Azure / AWS / GCP credentials (example)
AZURE_STORAGE_ACCOUNT=myazurestorage
AZURE_STORAGE_KEY=myazurestoragekey

# Logging and monitoring
LOG_LEVEL=debug
LOG_PATH=./logs/app.log

# Feature flags
ENABLE_ANALYTICS=true
ENABLE_CACHE=false
