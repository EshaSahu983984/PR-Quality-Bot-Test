#!/usr/bin/env bash
#
# commit-msg hook — enforce commit message generation through GitHub Copilot

commit_msg_file="$1"
commit_msg=$(head -n1 "$commit_msg_file")

# Detect if the commit message was auto-generated by GitHub Copilot
# (Note: GitHub Copilot-generated messages include metadata in VS Code GUI commits, not visible here.
# So we can't truly detect it; instead, we restrict manual `-m` commits.)

# Check if commit message file is present but commit came via `-m`
if [ -n "$GIT_EDITOR" ] && [[ "$GIT_EDITOR" == *"code"* ]]; then
  # Allow VS Code Copilot-generated commits (they invoke VS Code editor)
  echo "✅ Copilot or VS Code commit detected — allowed."
  exit 0
fi

# If commit message came directly from -m flag (manual commit)
if git log -1 --pretty=%B | grep -q "$commit_msg"; then
  echo "❌ Manual commit message detected!"
  echo "🚫 Please use GitHub Copilot's 'Generate Commit Message' feature in VS Code."
  echo ""
  echo "🧠 Tip: In VS Code, open Source Control → click '...' → 'Generate Commit Message with Copilot'."
  exit 1
fi

exit 0
