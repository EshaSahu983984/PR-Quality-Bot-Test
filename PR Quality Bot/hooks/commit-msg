#!/usr/bin/env bash
#
# commit-msg hook: validates Conventional Commit format
# Adds [copilot] prefix for AI-generated commits
# Suggests using VS Code GitHub Copilot for invalid messages.

commit_msg_file=$1
commit_msg=$(head -n1 "$commit_msg_file")

# ✅Conventional Commit regex pattern:
pattern='^(feat|fix|chore|docs|style|refactor|perf|test|build|ci|revert)(\(.+\))?: .+'

# ✅ Keywords that suggest the message was Copilot-generated
copilot_keywords=("Generated by Copilot" "GitHub Copilot" "[copilot]" "via Copilot")

echo "🔍 Validating commit message format..."

# 🧠 Detect if the commit message appears to be Copilot-generated
is_copilot_generated=false
for kw in "${copilot_keywords[@]}"; do
  if echo "$commit_msg" | grep -iq "$kw"; then
    is_copilot_generated=true
    break
  fi
done

# ⚙️ If Copilot-generated but missing prefix, add it
if [[ "$is_copilot_generated" == true && "$commit_msg" != "[copilot]"* ]]; then
  echo "🤖 Copilot-generated commit detected — adding '[copilot]' prefix."
  echo "[copilot] $commit_msg" > "$commit_msg_file"
  echo "✅ Commit message updated and allowed."
  exit 0
fi

# 🚦 Validate conventional commit format
if [[ ! $commit_msg =~ $pattern ]]; then
  echo ""
  echo "❌ Invalid commit message format!"
  echo "➡️  Your message: \"$commit_msg\""
  echo ""
  echo "✅ Expected Conventional Commit format:"
  echo "   <type>(optional scope): <short description>"
  echo ""
  echo "   Allowed types:"
  echo "     feat, fix, chore, docs, style, refactor, perf, test, build, ci, revert"
  echo ""
  echo "   Examples:"
  echo "     feat: add login API"
  echo "     fix(auth): handle invalid token case"
  echo "     refactor(ui): simplify button rendering"
  echo ""
  echo "💡 Tip: Use VS Code → Source Control → GitHub Copilot → 'Generate Commit Message'"
  echo "   to automatically create a properly formatted message."
  echo ""
  echo "🚫 Commit aborted. Please update your message and try again."
  exit 1
fi

echo "✅ Commit message OK"
exit 0
