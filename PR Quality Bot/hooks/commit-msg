#!/usr/bin/env bash
# commit-msg hook: conventional commit format + optional semantic check

MSG_FILE="$1"
if [ ! -f "$MSG_FILE" ]; then
  echo "Commit message file not found"
  exit 1
fi

MSG="$(tr -d '\r' < "$MSG_FILE")"

# Basic Conventional Commit format check
if [[ ! "$MSG" =~ ^(feat|fix|chore|refactor):[[:space:]]+.+$ ]]; then
  echo "Commit message must follow the pattern: feat|fix|chore|refactor: description"
  exit 1
fi

# Optional semantic check using local python script (if present)
if [ -f ".githooks/check_commit_semantics_openai.py" ]; then
  python3 .githooks/check_commit_semantics_openai.py "$MSG_FILE"
  rc=$?
  if [ $rc -ne 0 ]; then
    echo "Commit blocked due to vague message."
    echo "Use Copilot in VS Code to generate a better message if needed."
    exit $rc
  fi
fi

exit 0
